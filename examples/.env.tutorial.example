# Keep this file private and at mode 0600.
# Paste the full URL printed by pdm run dev, including its selected host port.
STARTUNNEL_BASE_URL=
STARTUNNEL_SENDER_KEY=replace-with-sender-key
STARTUNNEL_RECEIVER_KEY=replace-with-receiver-key

# Optional for the concurrent reply example.
STARTUNNEL_RECEIVER_KEYS=
