{
	log default {
		output stdout
		format filter {
			request>uri delete
			request>method delete
			request>headers delete
			resp_headers delete
			wrap json
		}
	}
}

{$STARTUNNEL_DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	reverse_proxy web:8000 {
		header_up Host {$STARTUNNEL_DOMAIN}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
		health_uri /health/ready
		health_interval 10s
		health_timeout 3s
		health_headers {
			Host {$STARTUNNEL_DOMAIN}
			X-Forwarded-Proto https
		}
	}

	log {
		output stdout
		format filter {
			request>uri delete
			request>method delete
			request>headers delete
			resp_headers delete
			wrap json
		}
	}
}
