# Local configuration. Generate private values with scripts/bootstrap_env.py.
# Keep .env untracked at mode 0600. See docs/operations.md for production setup.

# Application and browser access
STARTUNNEL_ENV=development
STARTUNNEL_BASE_URL=http://localhost:8001
STARTUNNEL_WEB_PORT=8001
STARTUNNEL_ALLOWED_HOSTS=localhost,127.0.0.1
STARTUNNEL_CSRF_TRUSTED_ORIGINS=
STARTUNNEL_SECURE_SSL_REDIRECT=false
STARTUNNEL_TRUSTED_PROXY_CIDRS=127.0.0.0/8,172.16.0.0/12
STARTUNNEL_MAX_REQUEST_BODY_BYTES=131072
STARTUNNEL_WEB_WORKERS=1

# Application secrets. These placeholders must not be used in a running service.
STARTUNNEL_SECRET_KEY=replace-with-at-least-50-random-characters
STARTUNNEL_API_KEY_PEPPER=replace-with-32-random-bytes-as-base64url
STARTUNNEL_ADDRESS_SECRET=replace-with-32-random-bytes-as-base64url
STARTUNNEL_ADDRESS_DERIVATION_SECRET=replace-with-32-random-bytes-as-base64url
STARTUNNEL_IDEMPOTENCY_SECRET=replace-with-32-random-bytes-as-base64url

# PostgreSQL. These hostnames are for the local Docker network.
DATABASE_URL=postgresql://startunnel:startunnel@postgres:5432/startunnel
DATABASE_ADMIN_URL=postgresql://startunnel_admin:startunnel_admin@postgres:5432/startunnel
STARTUNNEL_DATABASE_POOL_MAX_SIZE=40
STARTUNNEL_WEB_DATABASE_POOL_MAX_SIZE=18
STARTUNNEL_MAINTENANCE_DATABASE_POOL_MAX_SIZE=4

# Closed-history retention. Use a positive number of seconds or forever.
STARTUNNEL_HISTORY_RETENTION_SECONDS=2592000
STARTUNNEL_ACTIVE_CREDENTIAL_LIMIT=50

# Health and internal metrics
STARTUNNEL_LOG_LEVEL=INFO
STARTUNNEL_METRICS_TOKEN=replace-with-an-internal-token
# Isolated test processes only. Never point these at a shared database.
TEST_DATABASE_URL=postgresql://startunnel_admin:startunnel_admin@postgres:5432/startunnel

# Optional. These variables are only for the opt-in live-agent test container.
OPENAI_API_KEY=
OPENAI_MODEL=
