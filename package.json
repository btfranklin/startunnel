{
  "name": "startunnel-assets",
  "private": true,
  "description": "Self-hosted browser assets for StarTunnel",
  "dependencies": {
    "@fontsource/inter": ">=5 <6",
    "@fontsource/jetbrains-mono": ">=5 <6",
    "@fontsource/noto-sans-symbols": ">=5 <6",
    "@fontsource/space-grotesk": ">=5 <6",
    "highlight.js": ">=11 <12",
    "htmx.org": ">=2 <3",
    "swagger-ui-dist": ">=5 <6"
  },
  "scripts": {
    "vendor": "node scripts/vendor-assets.mjs",
    "check": "node --check static/js/site.js && node --check website/assets/js/signal-gate.js && node --check website/assets/js/prompt-navigation.js && node --check scripts/vendor-assets.mjs"
  }
}
